{
    "name": "nextcloud/autocomplete_settings",
    "description": "Allow users to opt-out from autocomplete suggestions in Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Tom Wezepoel",
            "email": "tom.wezepoel@surf.nl"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.5",
        "nextcloud/ocp": "dev-stable33",
        "psalm/phar": "^6.20"
    },
    "autoload": {
        "psr-4": {
            "OCA\\AutocompleteSettings\\": "lib/"
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './build/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm.phar --no-cache"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    }
}
