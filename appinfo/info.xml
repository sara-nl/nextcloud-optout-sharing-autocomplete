<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>autocomplete_settings</id>
    <name>Autocomplete Settings</name>
    <summary>Allow users to opt-out from autocomplete suggestions</summary>
    <description><![CDATA[This app allows users to hide themselves from autocomplete suggestions, for example when other users share files or folders or mention someone in a comment. Users can still be found by typing their exact username.]]></description>
    <version>1.0.1</version>
    <licence>agpl</licence>
    <author>Tom Wezepoel</author>
    <namespace>AutocompleteSettings</namespace>
    <category>tools</category>
    <bugs>https://github.com/sara-nl/nextcloud-optout-sharing-autocomplete/issues</bugs>

    <dependencies>
        <php min-version="8.2"/>
        <nextcloud min-version="33" max-version="35"/>
    </dependencies>

    <settings>
        <personal>OCA\AutocompleteSettings\Settings\Personal</personal>
    </settings>

    <collaboration>
        <plugins>
            <plugin type="collaborator-search" share-type="SHARE_TYPE_USER">OCA\AutocompleteSettings\Collaboration\HideOptedOutUsersPlugin</plugin>
        </plugins>
    </collaboration>
</info>
